  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
